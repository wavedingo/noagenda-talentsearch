# Core
APP_ENV=development
APP_URL=http://localhost:8000
SECRET_KEY=change-me-to-64-random-chars
DATABASE_URL=postgres://natsearch:natsearch@db:5432/natsearch
ALLOWED_HOSTS=localhost,127.0.0.1

# Email
RESEND_API_KEY=
MAIL_FROM="No Agenda Talent Search <hello@noagendatalentsearch.com>"
ADMIN_NOTIFY_EMAIL=hello@noagendatalentsearch.com

# Storage (R2). All five must be set for uploads to go to R2; with any of them
# missing the app falls back to local disk under MEDIA_ROOT, which is right for
# development and wrong for production (Render's filesystem is ephemeral).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nats-media
R2_PUBLIC_BASE_URL=

# Audio pipeline. The Dockerfile installs both; override only if they live
# somewhere unusual (e.g. a Homebrew path during local development).
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Anti-bot. Both set → widget on login and demo upload; either missing → off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Feed
RSS_FEED_URL=https://feeds.noagendaassets.com/noagenda.xml
# First-boot seed only (see below) -- the `settings` table owns this after that.
MIN_EPISODE_NUMBER=1890

# Monitoring
SENTRY_DSN=

# First-boot seed values ONLY -- after initial migration the `settings`
# table is the source of truth and these are ignored (see spec Sec 4.1).
VOTE_ELIGIBILITY_HOURS=48
MIN_VOTES_TO_DISPLAY=10
APPEARANCE_RATING_WINDOW_DAYS=14
DEMO_MAX_DURATION_SEC=900
DEMO_MAX_FILE_MB=50
LEADERBOARD_SIZE=10
SCORE_WEIGHT_APPEARANCE=0.7
SCORE_WEIGHT_DEMO=0.3
